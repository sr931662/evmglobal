# ── Database (MongoDB Atlas) ───────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=<min-32-char-random-string>
JWT_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# ── Cloudinary ─────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# ── Email (Gmail SMTP) ─────────────────────────────────────────────────────────
# The Gmail (or Google Workspace) account emails are sent from.
# Needs 2-Step Verification ON, then generate an App Password at
# myaccount.google.com/apppasswords (select app "Mail") — NOT your normal Gmail password.
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=<16-char app password, no spaces>
# Display name can be anything; the address must be GMAIL_USER (Gmail rejects
# sending "from" an address it doesn't own/verify as an alias).
MAIL_FROM=Ease My Vacations Global <youraddress@gmail.com>
ADMIN_EMAIL=socialmediaemvg@gmail.com   # email where lead/inquiry notifications are sent
ADMIN_PASSWORD=<strong-password>

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
# Example: https://evmglobal.pages.dev,https://www.evmglobal.com
FRONTEND_URL=https://<your-pages-subdomain>.pages.dev,https://www.<yourdomain>.com

# ── App ────────────────────────────────────────────────────────────────────────
# Cloud Run sets PORT automatically — do NOT add PORT to Cloud Run env vars
PORT=8080
